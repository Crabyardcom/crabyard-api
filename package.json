    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "hono": "^4.13.13",
    "postgres": "^3.4.9",
    "resend": "^6.34.1",
    "stripe": "^17.7.0"
  },
  "overrides": {
    "qs": "^6.16.1"
  }
}
